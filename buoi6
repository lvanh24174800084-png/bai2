# ================== 5. XAY DUNG MODEL ==================

def build_model(pretrained=True):

    model = models.efficientnet_b0(
        weights=WEIGHTS if pretrained else None
    )

    in_features = model.classifier[1].in_features

    model.classifier[1] = nn.Linear(
        in_features, NUM_CLASSES
    )

    return model


def configure_model(model, strategy):

    for p in model.parameters():
        p.requires_grad = False

    if strategy in ["scratch", "full"]:
        for p in model.parameters():
            p.requires_grad = True

    elif strategy == "probe":
        for p in model.classifier.parameters():
            p.requires_grad = True

    elif strategy == "partial":
        for p in model.features[-2:].parameters():
            p.requires_grad = True

        for p in model.classifier.parameters():
            p.requires_grad = True

    return model


def count_parameters(model):

    total = sum(
        p.numel() for p in model.parameters()
    )

    trainable = sum(
        p.numel() for p in model.parameters()
        if p.requires_grad
    )

    return {
        "Total": total,
        "Trainable": trainable,
        "Frozen": total-trainable
    }

# ================== 6. HAM DANH GIA ==================

criterion = nn.CrossEntropyLoss()

def evaluate(model, loader):

    model.eval()

    total_loss = 0
    total = 0
    correct = 0
    top5_correct = 0

    predictions = []
    targets = []

    with torch.inference_mode():

        for images, labels in loader:

            images = images.to(DEVICE)
            labels = labels.to(DEVICE)

            outputs = model(images)
            loss = criterion(outputs, labels)

            batch_size = labels.size(0)

            total_loss += loss.item() * batch_size
            total += batch_size

            preds = outputs.argmax(dim=1)

            correct += (
                preds == labels
            ).sum().item()

            top5 = outputs.topk(
                5, dim=1
            ).indices

            top5_correct += (
                top5 == labels.unsqueeze(1)
            ).any(dim=1).sum().item()

            predictions.extend(
                preds.cpu().numpy()
            )

            targets.extend(
                labels.cpu().numpy()
            )

    accuracy = correct / total

    macro_f1 = f1_score(
        targets,
        predictions,
        average="macro",
        labels=list(range(NUM_CLASSES)),
        zero_division=0
    )

    return {
        "loss": total_loss / total,
        "accuracy": accuracy,
        "macro_f1": macro_f1,
        "top5": top5_correct / total,
        "preds": np.array(predictions),
        "targets": np.array(targets)
    }

# ================== 7. HUAN LUYEN ==================

def train_one_epoch(model, loader, optimizer, strategy):

    model.train()

    # Khong cap nhat running statistics cua
    # BatchNorm trong backbone dong bang
    if strategy in ["probe", "partial"]:
        for module in model.modules():
            if isinstance(module, nn.BatchNorm2d):
                module.eval()

    total_loss = 0
    total = 0

    for images, labels in loader:

        images = images.to(DEVICE)
        labels = labels.to(DEVICE)

        optimizer.zero_grad(set_to_none=True)

        outputs = model(images)
        loss = criterion(outputs, labels)

        loss.backward()
        optimizer.step()

        total_loss += loss.item() * labels.size(0)
        total += labels.size(0)

    return total_loss / total


def fit_model(name, strategy, epochs):

    print("\n====================================")
    print("DANG HUAN LUYEN:", name)
    print("====================================")

    set_seed(SEED)

    model = build_model(
        pretrained=(strategy != "scratch")
    )

    model = configure_model(
        model, strategy
    ).to(DEVICE)

    print(count_parameters(model))

    if strategy == "scratch":
        optimizer = torch.optim.AdamW(
            model.parameters(),
            lr=1e-3,
            weight_decay=1e-4
        )

    elif strategy == "probe":
        optimizer = torch.optim.AdamW(
            model.classifier.parameters(),
            lr=1e-3
        )

    elif strategy == "partial":
        optimizer = torch.optim.AdamW([
            {
                "params": model.features[-2:].parameters(),
                "lr": 1e-4
            },
            {
                "params": model.classifier.parameters(),
                "lr": 1e-3
            }
        ])

    else:
        optimizer = torch.optim.AdamW([
            {
                "params": model.features.parameters(),
                "lr": 1e-5
            },
            {
                "params": model.classifier.parameters(),
                "lr": 1e-4
            }
        ])

    history = {
        "train_loss": [],
        "val_loss": [],
        "val_acc": [],
        "val_f1": [],
        "val_top5": []
    }

    best_loss = float("inf")
    best_state = None
    best_epoch = 0
    patience_count = 0

    for epoch in range(epochs):

        start = time.time()

        train_loss = train_one_epoch(
            model,
            train_loader,
            optimizer,
            strategy
        )

        metrics = evaluate(model, val_loader)

        history["train_loss"].append(train_loss)
        history["val_loss"].append(metrics["loss"])
        history["val_acc"].append(metrics["accuracy"])
        history["val_f1"].append(metrics["macro_f1"])
        history["val_top5"].append(metrics["top5"])

        print(
            f"Epoch {epoch+1}/{epochs} | "
            f"Train Loss: {train_loss:.4f} | "
            f"Val Loss: {metrics['loss']:.4f} | "
            f"Accuracy: {metrics['accuracy']*100:.2f}% | "
            f"F1: {metrics['macro_f1']:.4f} | "
            f"Top5: {metrics['top5']*100:.2f}% | "
            f"Time: {time.time()-start:.1f}s"
        )

        if metrics["loss"] < best_loss:

            best_loss = metrics["loss"]
            best_epoch = epoch + 1

            best_state = {
                k: v.detach().cpu().clone()
                for k, v in model.state_dict().items()
            }

            patience_count = 0

        else:
            patience_count += 1

        if patience_count >= PATIENCE:
            print("Early stopping")
            break

    model.load_state_dict(best_state)

    final_metrics = evaluate(model, val_loader)

    summary = {
        "Model": name,
        "Best epoch": best_epoch,
        "Val loss": final_metrics["loss"],
        "Val accuracy": final_metrics["accuracy"],
        "Val macro-F1": final_metrics["macro_f1"],
        "Val top-5": final_metrics["top5"]
    }

    return model, history, summary

# ================== 8. CHAY 4 THI NGHIEM ==================

histories = {}
